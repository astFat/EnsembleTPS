<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.ensemble_tps">

    <!-- Permissions nécessaires -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.SEND_SMS"/>
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="TPs Mobile - ILCS"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- ========================================== -->
        <!-- ACTIVITÉ PRINCIPALE : Menu -->
        <!-- ========================================== -->
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========================================== -->
        <!-- TP 1 : Java Sans XML -->
        <!-- ========================================== -->
        <activity android:name=".ProjetClickActivity"
            android:label="Exercice 1 : ProjetClick"
            android:parentActivityName=".MainActivity"/>

        <activity android:name=".ConsommationCarburantActivity"
            android:label="Exercice 2 : Consommation Carburant"
            android:parentActivityName=".MainActivity"/>

        <activity android:name=".ConvertisseurTemperatureActivity"
            android:label="Exercice 3 : Convertisseur Température"
            android:parentActivityName=".MainActivity"/>

        <activity android:name=".SaisieEtudiantActivity"
            android:label="Exercice 4 : Saisie Étudiant"
            android:parentActivityName=".MainActivity"/>

        <!-- ========================================== -->
        <!-- TP 2 : Android XML -->
        <!-- ========================================== -->
        <activity android:name=".PerimetreCercleActivity"
            android:label="Exercice 1 : Périmètre Cercle"
            android:parentActivityName=".MainActivity"/>

        <activity android:name=".ConvertisseurDevisesActivity"
            android:label="Exercice 2 : Convertisseur Devises"
            android:parentActivityName=".MainActivity"/>

        <activity android:name=".GestionEtudiantActivity"
            android:label="Exercice 3 : Gestion Étudiant"
            android:parentActivityName=".MainActivity"/>

        <!-- ========================================== -->
        <!-- TP 3 : Calculatrice -->
        <!-- ========================================== -->
        <activity android:name=".CalculatriceActivity"
            android:label="Calculatrice Android"
            android:parentActivityName=".MainActivity"/>

        <!-- ========================================== -->
        <!-- TP 4 : SMS et Menus -->
        <!-- ========================================== -->
        <activity android:name=".EnvoieSmsActivity"
            android:label="Envoi de SMS"
            android:parentActivityName=".MainActivity"/>

        <activity android:name=".MenuOptionsActivity"
            android:label="Menu Options Android"
            android:parentActivityName=".MainActivity"/>

        <!-- ========================================== -->
        <!-- TP 5 : ListView et Navigation -->
        <!-- ========================================== -->
        <activity android:name=".ListViewPersoActivity"
            android:label="ListView Personnalisée"
            android:parentActivityName=".MainActivity"/>

        <activity android:name=".NavigationIntentActivity"
            android:label="Navigation avec Intent"
            android:parentActivityName=".MainActivity"/>

        <!-- Activité secondaire pour la navigation -->
        <activity android:name=".QuestionActivity"
            android:label="Question Activity"
            android:parentActivityName=".NavigationIntentActivity"/>

    </application>

</manifest>