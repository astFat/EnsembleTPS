<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        tools:ignore="WebViewLayout">

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestion Étudiant"
            android:textSize="24sp"
            android:textColor="#444444"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Prénom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prénom :"
            android:textSize="16sp"
            android:textColor="#555555"/>

        <EditText
            android:id="@+id/etPrenom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez le prénom"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Nom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nom :"
            android:textSize="16sp"
            android:textColor="#555555"/>

        <EditText
            android:id="@+id/etNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez le nom"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email :"
            android:textSize="16sp"
            android:textColor="#555555"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez l'email"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="12dp"/>

        <!-- Année -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quelle année ?"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="6dp"/>

        <RadioGroup
            android:id="@+id/rgAnnee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1ère année"
                android:checked="true"
                android:layout_marginEnd="20dp"/>

            <RadioButton
                android:id="@+id/rb2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2ème année"/>
        </RadioGroup>

        <!-- Matière -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Matière :"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/spinnerMatiere"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <!-- Moyenne -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moyenne :"
            android:textSize="16sp"
            android:textColor="#555555"/>

        <EditText
            android:id="@+id/etMoyenne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez la moyenne"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:inputType="numberDecimal"
            android:layout_marginBottom="20dp"/>

        <!-- Bouton -->
        <Button
            android:id="@+id/btnEnregistrer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENREGISTRER"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="#BDBDBD"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"/>

        <!-- WebView -->
        <WebView
            android:id="@+id/webResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
